{
  "manifest_version": 3,
  "name": "Web to PDF (exact)",
  "version": "1.0.0",
  "description": "Save the page you're viewing as a PDF that looks exactly like it does on screen. Includes a PDF editor.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save this page as PDF",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "background": { "service_worker": "background.js" },
  "permissions": ["activeTab", "debugger", "downloads", "storage", "contextMenus"],
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+P" }, "description": "Open Web to PDF" }
  },
  "minimum_chrome_version": "116"
}
